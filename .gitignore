# Dependencies
node_modules
.pnpm-store

# Build outputs
dist
build
*.tsbuildinfo

# IDE
.idea
.vscode
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.local
.env.*.local
# Wrangler's local-dev secret/env file (dotenv-style, read automatically
# by `wrangler dev`) — this is where real CDP/wallet/Nevermined/Modal/
# Sentry secret VALUES belong for local development, never in
# wrangler.toml's [vars] (which IS committed to git) or any .env* file
# above. See docs/operations/CLOUDFLARE_PROVISIONING_CHECKLIST.md.
.dev.vars
.dev.vars.*
# ...except the committed, values-free template every real .dev.vars is
# copied from (.dev.vars.example) — a negation must come after the
# broader pattern above to take effect.
!.dev.vars.example

# Wrangler's local state directory (D1/KV/R2 local persistence, build
# cache) — .wrangler/secrets was previously the only entry here, which
# left the rest of .wrangler/ (including local D1 SQLite files that may
# contain test data) untracked by this rule.
.wrangler/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Test
coverage
.nyc_output

# Python
__pycache__
*.pyc
*.pyo
*.pyd
.Python
.venv
venv
pip-wheel-metadata

# Lock files (keep pnpm-lock.yaml for reproducibility, ignore others)
yarn.lock
package-lock.json

# SUN-1000 checkpoint 1B — provisioned security scanners (Semgrep venv,
# OSV-Scanner/Trivy binaries). Versions are pinned in
# security/tool-versions.json; the binaries themselves are never
# committed. Reports/output are also excluded (real findings, not
# committed evidence — the checkpoint report is the durable record).
.security-tools
security/output

# Turbo
.turbo

# Coverage
*.lcov

# Temporary
*.tmp
*.temp
tmp/

# Modal
.modal_environments

# OSV-Scanner
osv-scanner-cache

# Trivy
trivy-cache

# Gitleaks
gitleaks-report.json

# SUN-1000 checkpoint 1I — Schemathesis's own crash-replay cache
# (created in cwd by the schemathesis CLI itself, not requested by any
# wrapper option; contains generated test-case replay data, not
# committed evidence — the checkpoint report is the durable record).
.schemathesis
# Scratch schema codegen intermediates (regenerated by packages/pcc-schema/scripts)
.temp-combined-schemas/
.temp-ts-schemas/
.temp-schemas/
.service-drift-temp/
.service-drift-check/
# npm pack output (regenerated by `npm pack`/`pnpm pack:verify`, never
# committed evidence — a stray *.tgz from a manual `npm pack` was left
# untracked after SUN-0800B checkpoint 3).
*.tgz
