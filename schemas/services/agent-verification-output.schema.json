            "resolved_count": 2,
            "unresolved_count": 0
          },
          "claim_support_result": {
            "supported": true,
            "supported_count": 1,
            "unsupported_count": 0
          },
          "candidate_output_hash": "sha256:abcdef1234567890abcdef1234567890abcdef1234567890abcdef1234567890",
          "verifier_classes_used": [
            "schema_validator",
            "evidence_resolver"
          ],
          "policy_version": "v1"
        }
      }
    }
  ]
}
