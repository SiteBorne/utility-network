{
  "name": "@siteborne/edge-api",
  "version": "0.0.0",
  "private": true,
  "description": "Edge API - Hono on Cloudflare Workers",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "wrangler dev --config wrangler.toml",
    "build": "tsc && tsc -m ESNext --outDir dist/esm && mv dist/esm/*.mjs dist/ 2>/dev/null || true",
    "test": "vitest run",
    "lint": "eslint src/",
    "typecheck": "tsc --project tsconfig.json --noEmit --pretty false && tsc --project tsconfig.live-tests.json --noEmit --pretty false"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.0.1",
    "@coinbase/cdp-sdk": "^1.55.0",
    "@nevermined-io/payments": "1.10.0",
    "@siteborne/pricing": "workspace:*",
    "@siteborne/protocol-a2a": "workspace:*",
    "@siteborne/protocol-mcp": "workspace:*",
    "@siteborne/protocol-nevermined": "workspace:*",
    "@siteborne/protocol-x402": "workspace:*",
    "@siteborne/provider-adapters": "workspace:*",
    "@siteborne/service-runtime": "workspace:*",
    "@siteborne/verification": "workspace:*",
    "@x402/core": "^2.21.0",
    "@x402/evm": "^2.21.0",
    "@x402/extensions": "2.21.0",
    "@x402/svm": "2.21.0",
    "ajv": "^8.17.1",
    "express": "4.21.2",
    "hono": "^4.5.0",
    "viem": "^2.55.11",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240800.0",
    "@modelcontextprotocol/client": "2.0.0",
    "eslint": "^9.0.0",
    "fast-check": "^3.17.0",
    "miniflare": "5.20260801.0-alpha",
    "typescript": "^5.5.0",
    "vitest": "^2.1.9"
  }
}
