{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@siteborne/contracts": ["packages/contracts/src"],
      "@siteborne/pcc-schema": ["packages/pcc-schema/src"],
      "@siteborne/provider-adapters": ["packages/provider-adapters/src"],
      "@siteborne/verification": ["packages/verification/src"],
      "@siteborne/service-runtime": ["packages/service-runtime/src"],
      "@siteborne/knowledge-graph": ["packages/knowledge-graph/src"],
      "@siteborne/protocol-x402": ["packages/protocol-x402/src"],
      "@siteborne/protocol-mcp": ["packages/protocol-mcp/src"],
      "@siteborne/protocol-a2a": ["packages/protocol-a2a/src"],
      "@siteborne/protocol-nevermined": ["packages/protocol-nevermined/src"],
      "@siteborne/pricing": ["packages/pricing/src"],
      "@siteborne/policy": ["packages/policy/src"],
      "@siteborne/telemetry": ["packages/telemetry/src"],
      "@siteborne/test-fixtures": ["packages/test-fixtures/src"]
    }
  },
  "exclude": ["node_modules", "dist", "build", "**/*.test.ts", "**/*.spec.ts"]
}
