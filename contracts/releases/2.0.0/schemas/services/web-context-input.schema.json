{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siteborne.net/schemas/services/web-context-input.schema.json",
  "title": "Verified Web Context Input",
  "description": "Input schema for web_context_verified.v1 service. Supports direct and rendered retrieval modes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["target_url", "retrieval_mode"],
  "properties": {
    "target_url": {
      "type": "string",
      "description": "Target URL to retrieve. Public HTTP/HTTPS only.",
      "format": "uri",
      "maxLength": 2048
    },
    "retrieval_mode": {
      "type": "string",
      "description": "Retrieval mode.",
      "enum": ["direct", "rendered"]
    },
    "output_mode": {
      "type": "string",
      "description": "Desired output format.",
      "enum": ["clean_text", "markdown", "structured"],
      "default": "clean_text"
    },
    "buyer_schema": {
      "type": "object",
      "description": "Optional buyer-provided JSON Schema for structured output validation.",
      "additionalProperties": true,
      "maxProperties": 50,
      "maxDepth": 5
    },
    "field_selectors": {
      "type": "array",
      "description": "Requested field selectors for structured output.",
      "items": { "type": "string", "maxLength": 128 },
      "maxItems": 30
    },
    "freshness_seconds": {
      "type": "integer",
      "description": "Maximum acceptable age of cached content in seconds.",
      "minimum": 0,
      "maximum": 2592000,
      "default": 3600
    },
    "max_content_size": {
      "type": "integer",
      "description": "Maximum content size in bytes to return.",
      "minimum": 1024,
      "maximum": 10485760,
      "default": 1048576
    },
    "redirect_policy": {
      "type": "string",
      "description": "Redirect handling policy.",
      "enum": ["follow", "follow_first", "manual"],
      "default": "follow"
    },
    "max_redirects": {
      "type": "integer",
      "description": "Maximum number of redirects to follow.",
      "minimum": 0,
      "maximum": 10,
      "default": 5
    },
    "locale_hint": {
      "type": "string",
      "description": "Locale hint for content negotiation (BCP 47).",
      "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
    },
    "minimum_verification_score": {
      "type": "number",
      "description": "Minimum PCC verification score [0, 1].",
      "minimum": 0,
      "maximum": 1,
      "default": 0.7
    },
    "maximum_authorized_price": {
      "$ref": "https://siteborne.net/schemas/common/money.schema.json"
    }
  },
  "examples": [
    {
      "target_url": "https://acme.example.com/about",
      "retrieval_mode": "rendered",
      "output_mode": "markdown",
      "freshness_seconds": 3600,
      "maximum_authorized_price": { "amount": "0.029", "currency": "USD" }
    }
  ]
}
