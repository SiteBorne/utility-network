{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://utility.siteborne.net/contracts/3.0.0/schemas/services/agent-verification-output.schema.json",
  "title": "Agent Output Verification Output",
  "description": "Output schema for verify_agent_output.v1 service. Must be a valid PCC 1.0.0 document with required net.siteborne.agent-verification.v1 extension. Governed candidate output for Service Contract 3.0.0 / PCC 2.0.0.",
  "allOf": [
    {
      "$ref": "https://utility.siteborne.net/contracts/3.0.0/schemas/proof-carrying-context.schema.json"
    },
    {
      "type": "object",
      "required": ["contract", "extensions"],
      "properties": {
        "contract": {
          "type": "object",
          "required": ["service_id", "service_version", "output_schema_hash"],
          "properties": {
            "service_id": {
              "enum": ["verify_agent_output.v3"]
            },
            "service_version": {
              "enum": ["v3"]
            },
            "output_schema_hash": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          }
        },
        "extensions": {
          "type": "object",
          "required": ["net.siteborne.agent-verification.v1"],
          "propertyNames": {
            "type": "string",
            "minLength": 5,
            "maxLength": 253,
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?){2,}$"
          },
          "properties": {
            "net.siteborne.agent-verification.v1": {
              "type": "object",
              "additionalProperties": false,
              "description": "Agent verification extension payload.",
              "properties": {
                "verification_mode": {
                  "type": "string",
                  "enum": ["standard", "independent_reproduction"]
                },
                "outcome": {
                  "type": "string",
                  "enum": ["pass", "fail", "conditional"]
                },
                "score": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "requirement_results": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["requirement_id", "passed"],
                    "properties": {
                      "requirement_id": {
                        "type": "string"
                      },
                      "passed": {
                        "type": "boolean"
                      },
                      "details": {
                        "type": "string"
                      },
                      "evidence_ids": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "maxItems": 50
                },
                "schema_result": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["valid"],
                  "properties": {
                    "valid": {
                      "type": "boolean"
                    },
                    "errors": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                },
                "evidence_result": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["resolved", "unresolved_count"],
                  "properties": {
                    "resolved": {
                      "type": "boolean"
                    },
                    "resolved_count": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "unresolved_count": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "unresolved_ids": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                },
                "claim_support_result": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["supported", "unsupported_count"],
                  "properties": {
                    "supported": {
                      "type": "boolean"
                    },
                    "supported_count": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "unsupported_count": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "conflicting_count": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                },
                "reproduction_result": {
                  "type": "object",
                  "description": "Present only for independent_reproduction mode.",
                  "additionalProperties": false,
                  "properties": {
                    "reproduced": {
                      "type": "boolean"
                    },
                    "agreement_score": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "differences": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "path": {
                            "type": "string"
                          },
                          "candidate_value": {
                            "type": ["string", "number", "boolean", "null"]
                          },
                          "reproduced_value": {
                            "type": ["string", "number", "boolean", "null"]
                          }
                        }
                      },
                      "maxItems": 20
                    },
                    "reproduction_output_hash": {
                      "type": "string",
                      "pattern": "^sha256:[a-f0-9]{64}$"
                    }
                  }
                },
                "failed_requirements": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "maxItems": 50
                },
                "deterministic_failures": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["requirement_id", "reason"],
                    "properties": {
                      "requirement_id": {
                        "type": "string"
                      },
                      "reason": {
                        "type": "string"
                      },
                      "blocks_pass": {
                        "type": "boolean",
                        "const": true
                      }
                    }
                  },
                  "maxItems": 20
                },
                "unverifiable_assertions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "claim_id": {
                        "type": "string"
                      },
                      "reason": {
                        "type": "string"
                      }
                    }
                  },
                  "maxItems": 20
                },
                "limitations": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 256
                  },
                  "maxItems": 20
                },
                "candidate_output_hash": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                "reproduction_output_hash": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$",
                  "description": "Present only for independent_reproduction mode."
                },
                "reproduction_agreement_score": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "Present only for independent_reproduction mode."
                },
                "verifier_classes_used": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "maxItems": 10
                },
                "policy_version": {
                  "type": "string",
                  "pattern": "^v[0-9]+(\\.[0-9]+)*$"
                }
              }
            }
          }
        }
      }
    }
  ]
}
