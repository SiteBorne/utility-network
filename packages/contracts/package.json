{
  "name": "@siteborne/contracts",
  "version": "1.0.0",
  "private": true,
  "description": "Shared contract types for SITEBORNE Utility Network",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc && tsc -m ESNext --outDir dist/esm && mv dist/esm/*.mjs dist/ 2>/dev/null || true",
    "test": "vitest run",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "contracts:baseline:verify": "tsx scripts/compat.ts baseline:verify",
    "contracts:compat": "tsx scripts/compat.ts compat",
    "contracts:compat:check": "tsx scripts/compat.ts compat:check",
    "contracts:release:verify": "tsx scripts/compat.ts release:verify"
  },
  "dependencies": {
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "json-schema-library": "11.6.2",
    "typescript": "^5.5.0",
    "vitest": "^3.2.7",
    "yaml": "^2.5.0"
  }
}
