{
  "name": "@siteborne/pcc-schema",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "PCC normative schema package - Proof-Carrying Context 1.0.0",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc && tsc -m ESNext --outDir dist/esm && mv dist/esm/*.mjs dist/ 2>/dev/null || true",
    "test": "vitest run",
    "test:property": "vitest run --config vitest.property.config.ts",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "generate": "tsx scripts/generate-models.ts",
    "generate:check": "tsx scripts/drift-check.ts",
    "generate:services:prep": "tsx scripts/create-combined-schemas.ts && tsx scripts/create-ts-schemas.ts",
    "generate:services": "pnpm generate:services:prep && tsx scripts/generate-service-models.ts",
    "generate:services:check": "tsx scripts/drift-check-services.ts",
    "generate:openapi": "tsx scripts/generate-openapi.ts",
    "generate:openapi:check": "tsx scripts/drift-check-openapi.ts",
    "manifest:generate": "tsx scripts/generate-manifest.ts",
    "manifest:check": "tsx scripts/generate-manifest.ts --check",
    "validate:canonicalization": "tsx scripts/validate-canonicalization.ts",
    "validate:compatibility": "tsx scripts/validate-compatibility.ts",
    "validate:signing": "tsx scripts/validate-signing.ts"
  },
  "dependencies": {
    "zod": "^3.23.0",
    "canonical-json": "0.4.0",
    "@noble/ed25519": "^2.1.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^3.2.7",
    "eslint": "^9.0.0",
    "fast-check": "^3.17.0",
    "tsx": "^4.16.0"
  }
}
