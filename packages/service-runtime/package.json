{
  "name": "@siteborne/service-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local orchestration for the four frozen v1 services, composing provider-adapters, document-worker, and the verification mesh (SUN-0600)",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc && tsc -m ESNext --outDir dist/esm && mv dist/esm/*.mjs dist/ 2>/dev/null || true",
    "test": "vitest run",
    "test:property": "vitest run --config vitest.property.config.ts",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check src/",
    "fixtures:verify": "tsx scripts/verify-fixtures.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run test:property && pnpm run fixtures:verify"
  },
  "dependencies": {
    "@siteborne/pcc-schema": "workspace:*",
    "@siteborne/provider-adapters": "workspace:*",
    "@siteborne/verification": "workspace:*",
    "@noble/ed25519": "^2.1.0",
    "@cfworker/json-schema": "^4.1.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "zod": "^3.23.0",
    "fast-check": "^3.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^3.2.7"
  }
}
