  "facilitator_types": [
    "X402PaymentRequired",
    "VerifyPermissionsParams",
    "VerifyPermissionsResult",
    "SettlePermissionsParams",
    "SettlePermissionsResult"
  ],
  "facilitator_methods": ["verifyPermissions", "settlePermissions"],
  "payg_helpers": ["getPayAsYouGoPriceConfig", "getPayAsYouGoCreditsConfig"],
  "credit_helpers": ["getFixedCreditsConfig", "getDynamicCreditsConfig"],
  "registration_methods": ["registerPlan", "registerCreditsPlan"],
  "trial_registration_methods": ["registerCreditsTrialPlan", "registerTimeTrialPlan"],
  "sdk_declared_a2a_range": "^0.3.13",
  "siteborne_direct_a2a_version": "1.0.1"
