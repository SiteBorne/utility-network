{
  "name": "@siteborne/protocol-nevermined",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Credential-independent Nevermined alternative-rail declarations, policy, codecs, and drift guards",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "format:check": "prettier --check src/ scripts/ fixtures/",
    "lint": "eslint src/ scripts/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root ../.. packages/protocol-nevermined/src",
    "fixtures:verify": "vitest run --root ../.. packages/protocol-nevermined/src/fixtures.test.ts",
    "spec:verify": "node --import tsx scripts/verify-spec-fixture.ts",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run fixtures:verify && pnpm run spec:verify"
  },
  "dependencies": {
    "@siteborne/pricing": "workspace:*",
    "@siteborne/protocol-x402": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^3.2.7"
  }
}
