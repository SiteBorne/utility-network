{
  "name": "@siteborne/protocol-a2a",
  "version": "0.1.0",
  "private": true,
  "description": "Credential-independent SITEBORNE A2A v1 protocol, signed Agent Card, and Hono transport boundary",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "format:check": "prettier --check src/ scripts/ fixtures/",
    "lint": "eslint src/ scripts/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:property": "vitest run --config vitest.property.config.ts",
    "fixtures:verify": "vitest run src/fixtures.test.ts",
    "spec:verify": "node --import tsx scripts/verify-spec-fixture.ts",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run test:property && pnpm run fixtures:verify && pnpm run spec:verify"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.0.1",
    "@siteborne/protocol-x402": "workspace:*",
    "ajv": "^8.17.1",
    "hono": "^4.5.0"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "fast-check": "^3.17.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.9"
  }
}
