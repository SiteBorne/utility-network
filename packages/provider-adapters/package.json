{
  "name": "@siteborne/provider-adapters",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Credential-independent authoritative public-data adapters for SITEBORNE Utility Network",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc && tsc -m ESNext --outDir dist/esm && mv dist/esm/*.mjs dist/ 2>/dev/null || true",
    "test": "vitest run",
    "test:property": "vitest run --config vitest.property.config.ts",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "fixtures:verify": "tsx scripts/verify-fixtures.ts && tsx scripts/verify-fixture-matrix.ts",
    "fixture-matrix:verify": "tsx scripts/verify-fixture-matrix.ts",
    "manifests:verify": "tsx scripts/verify-manifests.ts",
    "adapter:test": "vitest run src/tests/adapter-execution.test.ts",
    "drift:test": "vitest run src/drift/drift.test.ts",
    "provider-drift:test": "vitest run src/drift/provider-drift.test.ts",
    "terms-rate-cache-circuit:test": "vitest run src/tests/terms-rate-cache-circuit.test.ts",
    "http-ssrf:test": "vitest run src/tests/http-ssrf.test.ts",
    "fast-check:test": "vitest run src/tests/fast-check.test.ts",
    "live-gates:test": "vitest run src/tests/live-gates.test.ts",
    "all:test": "vitest run",
    "format:check": "prettier --check src/",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run test:property && pnpm run fixtures:verify && pnpm run manifests:verify"
  },
  "dependencies": {
    "fast-check": "^3.17.0",
    "glob": "^11.0.0",
    "yaml": "^2.5.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/jsdom": "28.0.3",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "jsdom": "26.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.9"
  }
}
